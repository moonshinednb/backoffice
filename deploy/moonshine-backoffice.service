[Unit]
Description=Moonshine Backoffice
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=moonshine
Group=moonshine
WorkingDirectory=/opt/moonshine-backoffice
EnvironmentFile=/opt/moonshine-backoffice/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/moonshine-backoffice/server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/moonshine
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
